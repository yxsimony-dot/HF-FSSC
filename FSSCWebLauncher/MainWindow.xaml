<Window x:Class="FSSCWebLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="华发 FSSC"
        Width="1280"
        Height="820"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="49" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,7"
                Background="#F7F9FC"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SendReceiptButton"
                        Grid.Column="0"
                        Content="发送回单"
                        Height="34"
                        Padding="14,6"
                        Background="#1261A0"
                        BorderBrush="#1261A0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="OnSendReceiptClicked"
                        AutomationProperties.Name="发送回单" />

                <Button x:Name="ChooseDirectoryButton"
                        Grid.Column="2"
                        Height="34"
                        Padding="12,6"
                        Background="White"
                        BorderBrush="#AEB8C6"
                        Foreground="#243447"
                        Click="OnChooseDirectoryClicked"
                        AutomationProperties.Name="设置回单目录">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Text="&#xE8B7;" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="设置目录" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="4"
                        Height="34"
                        Padding="10,0"
                        Background="White"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1">
                    <TextBlock x:Name="DirectoryPathText"
                               VerticalAlignment="Center"
                               Foreground="#536273"
                               Text="尚未设置回单目录"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               AutomationProperties.Name="当前回单目录" />
                </Border>

                <Button x:Name="ChooseCompletedDirectoryButton"
                        Grid.Column="6"
                        Height="34"
                        Padding="12,6"
                        Background="White"
                        BorderBrush="#AEB8C6"
                        Foreground="#243447"
                        Click="OnChooseCompletedDirectoryClicked"
                        AutomationProperties.Name="设置已完成目录">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Text="&#xE8B7;" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="设置已完成目录" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="8"
                        Height="34"
                        Padding="10,0"
                        Background="White"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1">
                    <TextBlock x:Name="CompletedDirectoryPathText"
                               VerticalAlignment="Center"
                               Foreground="#536273"
                               Text="尚未设置已完成目录"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               AutomationProperties.Name="当前已完成目录" />
                </Border>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
